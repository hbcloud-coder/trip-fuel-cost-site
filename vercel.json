{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(python-requests|python-urllib|aiohttp|httpx|Scrapy|Go-http-client|okhttp|libwww-perl|Wget|curl/|HeadlessChrome|PhantomJS|Bytespider|AhrefsBot|SemrushBot|MJ12bot|DotBot|PetalBot|BLEXBot|DataForSeoBot|serpstatbot|MegaIndex|ZoominfoBot).*"
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    }
  ]
}
